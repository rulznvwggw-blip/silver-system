# Telegram Bot Management Platform Environment Variables

# 1. Telegram Bot Token (Dapatkan dari @BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Admin Configuration (Primary Super Admin ID)
ADMIN_ID=7128038268
TIMEZONE=Asia/Jakarta

# 3. Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_bot_db
REDIS_URL=redis://localhost:6379

# 4. AI Provider API Key (Google Gemini / OpenAI)
AI_PROVIDER=gemini
AI_API_KEY=YOUR_GEMINI_OR_OPENAI_API_KEY

# 5. Web Dashboard Port & Settings
WEB_PORT=3005
AUTO_BROADCAST_MINUTES=30
